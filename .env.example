# Local-only. Never expose this unauthenticated app through a proxy or tunnel.
STREAMFX_HOST=127.0.0.1
PORT=3000
# Set to "json" for structured logs; development defaults to pretty output.
LOG_FORMAT=
DATABASE_URL=file:../../../data/streamfx.db
# Optional: set to "memory" for per-process cooldowns (reset on restart). Empty uses SQLite.
COOLDOWN_STORE=
# Seed bootstrap: admin login created by `npm run prisma:seed`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# Optional demo user (set password to create).
DEMO_USER_PASSWORD=
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,image/gif,image/webp,video/mp4,video/quicktime,video/webm,audio/mpeg,audio/ogg,audio/wav
# Same-origin requests already allowed. Keep empty unless explicitly needed locally.
CORS_ORIGIN=