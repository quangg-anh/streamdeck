# Local-only. Never expose this unauthenticated app through a proxy or tunnel.
STREAMFX_HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://streamfx:streamfx@127.0.0.1:5432/streamfx?schema=public
# Optional: leave empty for in-memory cooldowns (reset on restart).
REDIS_URL=
DEV_USER_ID=dev-user
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,image/gif,image/webp,video/mp4,video/webm,audio/mpeg,audio/ogg,audio/wav
# Same-origin requests already allowed. Keep empty unless explicitly needed locally.
CORS_ORIGIN=