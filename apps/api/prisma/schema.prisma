generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QueueMode {
  QUEUE
  REPLACE
  DROP
}

model User {
  id             String    @id @default(cuid())
  username       String    @unique
  passwordHash   String
  role           String    @default("USER")
  blocked        Boolean   @default(false)
  deckLimit      Int       @default(1)
  planExpiresAt  DateTime?
  projects       Project[]
  sessions       Session[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Project {
  id           String       @id @default(cuid())
  name         String
  description  String       @default("")
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  overlayToken String       @unique @default(cuid())
  effects      Effect[]
  buttons      DeckButton[]
  assets       Asset[]
  settings     Settings?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId])
}
model Effect {
  id         String       @id @default(cuid())
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  actions    Json
  mode       QueueMode    @default(QUEUE)
  cooldownMs Int          @default(0)
  enabled    Boolean      @default(true)
  buttons    DeckButton[]

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model DeckButton {
  id         String  @id @default(cuid())
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label      String
  color      String  @default("#7c3aed")
  icon       String?
  effectId   String
  effect     Effect  @relation(fields: [effectId], references: [id], onDelete: Cascade)
  position   Int     @default(0)
  enabled    Boolean @default(true)
  cooldownMs Int     @default(0)
}

model Asset {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  path      String
  size      Int
  sha256    String
  createdAt DateTime @default(now())
}

model Settings {
  projectId     String  @id
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  volume        Float   @default(0.8)
  queueLimit    Int     @default(50)
  developerMode Boolean @default(false)
  userToken     String  @unique @default(cuid())
}

// Atomic cooldown claims; expired rows are re-claimed via delete + create in one transaction.
model Cooldown {
  key       String   @id
  expiresAt DateTime
}
